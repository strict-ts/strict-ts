{
  "name": "@strict-ts/core",
  "version": "0.0.0",
  "description": "The strict-ts rule engine. No dependency on Node: it runs in the CLI, the editor and the browser.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./typescript6": {
      "types": "./dist/typescript6/provider.d.ts",
      "default": "./dist/typescript6/provider.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@typescript/typescript6": "^6.0.2"
  },
  "peerDependenciesMeta": {
    "@typescript/typescript6": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2"
  }
}
