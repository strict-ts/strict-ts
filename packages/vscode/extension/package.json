  "version": "0.0.1",
  "publisher": "strict-ts",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "@strict-ts/language-service",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  }
}
