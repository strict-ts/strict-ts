{
  "name": "@strict-ts/cli",
  "version": "0.0.0",
  "description": "The strict-ts CI gate: replaces tsc --noEmit, with a baseline and JSON / SARIF output.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./baseline": {
      "types": "./dist/baseline.d.ts",
      "default": "./dist/baseline.js"
    }
  },
  "files": [
    "dist",
    "strict-ts.schema.json"
  ],
  "bin": {
    "strict-ts": "./dist/main.js"
  },
  "dependencies": {
    "@strict-ts/core": "workspace:*",
    "@strict-ts/std": "workspace:*",
    "@typescript/typescript6": "^6.0.2"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0"
  },
  "scripts": {
    "schema": "node -e \"import('./dist/index.js').then((m) => require('node:fs').writeFileSync('strict-ts.schema.json', m.serializeConfigSchema()))\""
  }
}
