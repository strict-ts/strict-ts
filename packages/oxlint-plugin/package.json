      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@strict-ts/core": "workspace:*"
  },
  "devDependencies": {
    "@strict-ts/cli": "workspace:*"
  }
}
